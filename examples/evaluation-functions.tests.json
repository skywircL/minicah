{
  "schemaVersion": 1,
  "id": "function-repair",
  "version": "1.0.0",
  "tests": [
    {
      "id": "clamp",
      "module": "src/clamp.cjs",
      "export": "clamp",
      "cases": [
        {
          "id": "below",
          "args": [
            -2,
            0,
            10
          ],
          "expected": 0
        },
        {
          "id": "inside",
          "args": [
            4,
            0,
            10
          ],
          "expected": 4
        },
        {
          "id": "above",
          "args": [
            20,
            0,
            10
          ],
          "expected": 10
        },
        {
          "id": "fraction",
          "args": [
            1.5,
            -2,
            2
          ],
          "expected": 1.5
        },
        {
          "id": "equal-bounds",
          "args": [
            9,
            2,
            2
          ],
          "expected": 2
        },
        {
          "id": "invalid-range",
          "args": [
            0,
            3,
            2
          ],
          "throws": "RangeError"
        }
      ]
    },
    {
      "id": "median",
      "module": "src/median.cjs",
      "export": "median",
      "cases": [
        {
          "id": "one",
          "args": [
            [
              7
            ]
          ],
          "expected": 7
        },
        {
          "id": "numeric-sort",
          "args": [
            [
              1,
              10,
              2
            ]
          ],
          "expected": 2
        },
        {
          "id": "even",
          "args": [
            [
              4,
              1,
              3,
              2
            ]
          ],
          "expected": 2.5
        },
        {
          "id": "negative",
          "args": [
            [
              -3,
              -1,
              -2
            ]
          ],
          "expected": -2
        },
        {
          "id": "duplicates",
          "args": [
            [
              2,
              2,
              9,
              2
            ]
          ],
          "expected": 2
        },
        {
          "id": "empty",
          "args": [
            []
          ],
          "throws": "RangeError"
        }
      ]
    }
  ]
}
