ANTHROPIC_API_KEY=
# --provider pi --pi-provider google (GOOGLE_API_KEY is also accepted)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
