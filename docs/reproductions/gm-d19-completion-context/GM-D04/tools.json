  {
    "function": {
      "description": "Read UTF-8 text and its full-file content hash. Use the hash for edits.",
      "name": "read_file",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "lineCount": {
            "maximum": 300,
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "maxLength": 4096,
            "type": "string"
          },
          "startLine": {
            "minimum": 1,
